# 复制为 .env 后修改：cp .env.example .env

# 服务监听（生产环境由 OpenResty 反代，保持 127.0.0.1 即可；局域网调试改成 0.0.0.0）
PORT=3000
HOST=127.0.0.1

# ---- AI 主持人（Claude API）----
# 不填 Key 也能玩：主持人会使用内置台词
ANTHROPIC_API_KEY=
# 默认 claude-opus-5-5；想要更快的回复可换成 claude-haiku-5-5
AI_MODEL=claude-opus-5-5
# 单次调用超时（毫秒），超时自动换成内置台词
AI_TIMEOUT_MS=6000
# 设为 1 可强制关闭 AI（比如现场网络不稳时）
AI_DISABLED=0
